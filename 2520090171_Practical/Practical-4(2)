#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    pid_t pid;

    printf("Parent process PID = %d\n", getpid());

    pid = fork();

    if (pid < 0)
    {
        perror("fork failed");
        return 1;
    }

    if (pid == 0)
    {
        printf("Child process PID = %d\n", getpid());
        printf("Child process is exiting...\n");
        exit(0);
    }
    else
    {
        printf("Parent is sleeping without calling wait().\n");
        printf("Child becomes a zombie after termination.\n");

        sleep(20);

        printf("Parent process is now terminating.\n");
    }

    return 0;
}

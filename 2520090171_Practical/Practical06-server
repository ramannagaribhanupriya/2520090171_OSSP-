#include <stdio.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>
#include <string.h>

#define FIFO1 "client_to_server"
#define FIFO2 "server_to_client"

int main() {
    char message[100];
    char response[100];

    mkfifo(FIFO1, 0666);
    mkfifo(FIFO2, 0666);

    printf("Server waiting for client...\n");

    int fd1 = open(FIFO1, O_RDONLY);
    read(fd1, message, sizeof(message));
    close(fd1);

    printf("Client message: %s", message);

    strcpy(response, "Message received successfully!");

    int fd2 = open(FIFO2, O_WRONLY);
    write(fd2, response, strlen(response) + 1);
    close(fd2);

    return 0;
}

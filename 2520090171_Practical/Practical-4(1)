#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main()
{
    pid_t child1, child2, child3;
    int status;

    printf("Parent process started. PID = %d\n", getpid());

    // Create Child 1
    child1 = fork();

    if (child1 == 0)
    {
        printf("Child 1: PID = %d, Parent PID = %d\n",
               getpid(), getppid());
        sleep(2);
        printf("Child 1 completed.\n");
        exit(10);
    }

    // Create Child 2
    child2 = fork();

    if (child2 == 0)
    {
        printf("Child 2: PID = %d, Parent PID = %d\n",
               getpid(), getppid());
        sleep(1);
        printf("Child 2 completed.\n");
        exit(20);
    }

    // Create Child 3
    child3 = fork();

    if (child3 == 0)
    {
        printf("Child 3: PID = %d, Parent PID = %d\n",
               getpid(), getppid());
        sleep(3);
        printf("Child 3 completed.\n");
        exit(30);
    }

    // Parent waits for any child using wait()
    printf("\nParent is waiting using wait()...\n");

    pid_t finished = wait(&status);

    if (WIFEXITED(status))
    {
        printf("wait(): Child PID %d finished with exit status %d\n",
               finished, WEXITSTATUS(status));
    }

    // Parent waits specifically for Child 2 using waitpid()
    printf("\nParent is waiting for Child 2 using waitpid()...\n");

    waitpid(child2, &status, 0);

    if (WIFEXITED(status))
    {
        printf("waitpid(): Child 2 (PID %d) finished with exit status %d\n",
               child2, WEXITSTATUS(status));
    }

    // Wait for remaining children
    waitpid(child1, &status, 0);
    waitpid(child3, &status, 0);

    printf("\nAll child processes completed.\n");
    printf("Parent process completed.\n");

    return 0;
}
